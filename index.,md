          <!-- Title -->
          <div class="title">Safety Quantification for Nonlinear and Time-Delay Systems using Occupation Measures</div>
          <!-- Author -->
          <div class="author">
                <em>Miller, Jared</em>
          </div>

          <!-- Journal/Book title and date -->
          <div class="periodical">
            <em>IEEE Control Systems Letters</em> 2023
          </div>
        
          <!-- Links/Buttons -->
          <div class="links">
            <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
            <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
            <a href="https://repository.library.northeastern.edu/files/neu:4f196v79r" class="btn btn-sm z-depth-0" role="button" target="_blank" rel="noopener noreferrer">HTML</a>
            <a href="/assets/pdf/Thesis_Final.pdf" class="btn btn-sm z-depth-0" role="button">PDF</a>
